{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage-sh",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],

  // Taking this custom domain makes Cloudflare replace usage.sh's DNS records.
  // Today they are GitHub Pages A records (185.199.108-111.153) serving a 404,
  // so nothing real is displaced — but the API token needs Zone:DNS:Edit on the
  // usage.sh zone as well as Workers Scripts:Edit, or the deploy fails here.
  "routes": [{ "pattern": "usage.sh", "custom_domain": true }],

  // No static assets: pages are server-rendered (see src/render.ts). Nothing to
  // build, nothing to upload, and the fastest thing we can serve.

  "kv_namespaces": [
    // Not yet used. Detection results and rendered pages are currently cached by
    // Cloudflare's edge cache via cache-control alone, which is sufficient until
    // there is an index to persist.
    // { "binding": "CACHE", "id": "TODO" }
  ],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
