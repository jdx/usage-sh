{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage-sh",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],

  // A CDN cache in front of the Worker. Workers normally run *before* cache, so
  // a Worker-generated response is never stored by the edge — which is why
  // responses here came back with no cf-cache-status at all. With this on, a
  // cacheable request is served from cache without executing the Worker, driven
  // entirely by the Cache-Control headers the pages already set.
  "cache": { "enabled": true },

  // usage.sh is the only intended entry point. Leaving these on publishes the
  // same content at usage-sh.deps.workers.dev plus a per-deployment preview URL.
  "workers_dev": false,
  "preview_urls": false,

  // No `routes` here on purpose.
  //
  // A `custom_domain` route makes wrangler rewrite the zone's DNS, which needs
  // Zone:DNS:Edit on top of Workers Scripts:Edit. usage.sh is attached by hand
  // in the dashboard instead, and wrangler leaves routes it does not declare
  // alone, so the binding survives every deploy.

  // Bindings MUST be declared here even though they were created in the
  // dashboard: `wrangler deploy` treats this file as authoritative and drops
  // any binding it does not find, so an omission here silently unbinds them on
  // the next deploy.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e9c42a8c00044d61866484d66bf0d112"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usage-sh",
      "database_id": "725d6166-8649-4ee2-8b53-954e840608d6",
      // Per-binding, not top-level — wrangler warns "Unexpected fields found in
      // top-level field" otherwise and falls back to the ./migrations default,
      // which happened to be the same directory. Its own runner tracks applied
      // files in a `d1_migrations` table; CI applies them after deploy.
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
