{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage-sh",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],

  // No `routes` here on purpose.
  //
  // A `custom_domain` route makes wrangler rewrite the zone's DNS, which needs
  // Zone:DNS:Edit on top of Workers Scripts:Edit. Attaching the domain by hand
  // once, in the dashboard, keeps the deploy token scoped to Workers only —
  // and wrangler leaves routes it does not declare alone, so the binding
  // survives every subsequent deploy.

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
